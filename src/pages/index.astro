---
/**
 * 今日页 `/`：渲染 `siteConfig.site.timeZone` 里的「今天」。
 *
 * 「今天」的唯一依据是配置里的时区，绝不用本地时区或手写偏移推导——见 `src/lib/date.ts`。
 * 数据在构建期从磁盘读入（`data.ts` 只允许构建期使用），页面输出零 JS。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DayView from '../components/DayView.astro';
import { dayFileState, readDayFromDisk } from '../lib/data';
import { addDays, todayInZone } from '../lib/date';
import { siteConfig } from '../../site.config.ts';

const { activeDir, archiveDir } = siteConfig.data;
const today = todayInZone(siteConfig.site.timeZone);

// `readDayFromDisk` 把「没有这一天」与「有文件读不出来」都收敛成 null，
// 所以必须再问一次 dayFileState：否则一个坏文件会让首页谎称「今天还没有写下任何事」。
const state = dayFileState(activeDir, archiveDir, today);
if (state === 'corrupt') {
  console.warn(`[今日页] ${today} 的记录文件存在但读不出来，页面将显示「读不出来」而不是「没有记录」。`);
}

const entry = readDayFromDisk(activeDir, archiveDir, today);

// 相邻那天「有记录」既包括可读的一天，也包括坏文件——后者也有文件，点进去能看清明细。
const prevHasData = dayFileState(activeDir, archiveDir, addDays(today, -1)) !== 'absent';
const nextHasData = dayFileState(activeDir, archiveDir, addDays(today, 1)) !== 'absent';
---

<!-- canonical 不需要在这里指定：`/` 是自己的规范地址，BaseLayout 按当前 pathname 拼即可。 -->
<BaseLayout title="今天" activeNav="today">
  <DayView
    dateKey={today}
    entry={entry}
    corrupt={state === 'corrupt'}
    prevHasData={prevHasData}
    nextHasData={nextHasData}
    todayKey={today}
  />
</BaseLayout>
