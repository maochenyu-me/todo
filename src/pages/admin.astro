---
/**
 * 后台入口 `/admin`：全站**唯一**带客户端 JS 的页面。
 *
 * ## 为什么不用 `BaseLayout`
 *
 * `BaseLayout` 会把前台那套东西一起套上来：`Rail`（品牌、五个导航标签、明暗切换）、
 * 40rem 的「簿纸」正文度量、跳转链接，以及 canonical / hreflang。后台是一张要占满
 * 宽度的操作台：它不该出现前台导航（点进去就是公开站点的语境），也不该被正文行宽
 * 限制。所以这里是一份自带的极简外壳，比给 `BaseLayout` 加一堆 "后台模式" 开关更干净。
 *
 * 代价与取舍：`BaseLayout` 末尾那三段全局样式（焦点环、选区色、减少动效）本该共用，
 * 但 `src/styles/global.css` 的令牌值已冻结（客户批准的色板，逐字节不可动），
 * 所以在这里原样重述一份，下面有注释标明"两者是同一份规则"。
 *
 * 保留的只有 `BaseLayout` 里那段"首帧前定明暗"的内联脚本：后台同样要跟随用户选过的
 * 三态主题，否则会先白后黑闪一下。
 *
 * ## 索引
 *
 * `noindex` + 不写 canonical：这是一页私人工具，不该出现在搜索结果里，
 * 而 sitemap 也已经在 `astro.config.mjs` 里把它排除（noindex 与"收进 sitemap"
 * 是互相矛盾的两句话，只能留一句）。
 */
import '../styles/global.css';
import AdminApp from '../admin/AdminApp';
import { siteConfig } from '../../site.config.ts';

const title = `后台｜${siteConfig.site.title}`;
---

<!doctype html>
<html lang={siteConfig.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <!-- 与 BaseLayout 同一段内联脚本（首帧前跑，避免闪白/闪黑）：三态取
         localStorage["todo.theme"]，缺键或非法值一律当 system，再按
         prefers-color-scheme 决定是否加 .dark。 -->
    <script is:inline>(function(){var d=document.documentElement,t;try{t=localStorage.getItem("todo.theme")}catch(e){}if(t!=="light"&&t!=="dark")t="system";var k=t==="dark"||(t==="system"&&matchMedia("(prefers-color-scheme:dark)").matches);d.dataset.theme=t;d.classList.toggle("dark",k);d.style.colorScheme=k?"dark":"light"})()</script>
  </head>
  <body class="min-h-dvh bg-background text-foreground">
    {/*
      全站唯一的 `client:*`。`client:only="react"` 是刻意的：后台没有 SEO 或首屏
      可读性要求，而它一旦参与 SSR，`@astrojs/react` 的 renderer 会把 React 运行时
      也拖进服务端产物，还要配一份水合一致性。这里干脆整块交给浏览器。
      代价是首帧前没有 HTML——所以上面那句色板背景由 `<body>` 的 class 兜住，
      不会先闪一块白。
    */}
    <AdminApp siteTitle={siteConfig.site.title} client:only="react" />
  </body>
</html>

<style is:global>
  /*
    与 BaseLayout 末尾同一份规则（后台没有继承那个布局，所以在这里重述一遍）。
    改这里的时候记得同步改 src/layouts/BaseLayout.astro，否则前台与后台的焦点环会走样。
  */

  /* 键盘焦点：所有可交互元素共用 --primary 的可见焦点环。
     明确关掉过渡——焦点环必须立刻出现，不能从文字色渐变过去。 */
  :focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    transition: none;
  }

  ::selection {
    background-color: color-mix(in oklab, var(--primary) 22%, transparent);
  }

  /* prefers-reduced-motion：关闭全部过渡、动画与平滑滚动 */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
