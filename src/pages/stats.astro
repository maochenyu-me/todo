---
/**
 * 统计页 `/stats`：**构建期内联 SVG，零 JS**。
 *
 * 四块，顺序固定：总完成率大数字 → 连续打卡大数字 → 近 12 周柱状 → 90 天折线。
 * 大数字在前是因为它们是「结论」，两张图是「何以见得」——读者先要知道自己怎么样，
 * 才有兴趣看走势。图放前面则是另一种叙事（先看形状再读结论），与这本簿子的
 * 语气不符：它更像账簿的月末小结，不像仪表盘。
 *
 * 铁律：
 * - **不引入任何图表库**（spec 的零 JS 承诺）：两张图都是构建期算好坐标、
 *   直接写进 HTML 的静态 `<svg>`。
 * - **算全部委托 `stats.ts`**：本页不做除法。`rate` 是 0..1 的比值，显示时才乘 100。
 * - **不列出任何事项标题**：这一页只谈数量，不谈内容。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import BarSquares from '../components/charts/BarSquares.astro';
import LineChart from '../components/charts/LineChart.astro';
import { loadAllEntries } from '../lib/data';
import { addDays, addMonths, formatLong, parseDateKey, todayInZone } from '../lib/date';
import { daySummary, rollingRate, streak, weeklyDone } from '../lib/stats';
import { siteConfig } from '../../site.config.ts';

const { activeDir, archiveDir } = siteConfig.data;
const { entries, errors } = loadAllEntries(activeDir, archiveDir);

// 坏文件不打断构建（既定策略），但也不许悄悄消失：统计页是全面板里最容易被
// 「少了一份数据」骗过去的地方——数字变小了，看起来仍然像个正常数字。
for (const error of errors) {
  console.warn(`[统计页] 读取数据出错，这部分不计入统计：${error.path} —— ${error.message}`);
}

const statsConfig = siteConfig.frontend.stats;
const { showCompletionRate, showStreak, showTrend } = statsConfig;

/** 「今天」的唯一依据：站点时区。统计窗口全部以它为右端。 */
const todayKey = todayInZone(siteConfig.site.timeZone);

/* ---------------- 一、总完成率 ---------------- */

/**
 * 总完成率的统计窗口，由 `frontend.stats.range` 决定。
 *
 * 目前配置里只有 `'last-12-months'` 一个取值，含义是「今天往回推 12 个月」。
 * 若将来配置里出现本页不认识的取值，左边界**不设**（算全部有记录的日子）：
 * 多算一点是保守的错，静默把一个窗口算成空则是骗人的错。
 */
const windowStart = statsConfig.range === 'last-12-months' ? addMonths(todayKey, -12) : null;
const windowLabel = statsConfig.range === 'last-12-months' ? '近 12 个月' : '有记录以来';

/** 窗口内的条目：晚于今天的（坏数据里的未来日期）一律不计。 */
const windowEntries = entries.filter(
  (entry) => entry.date <= todayKey && (windowStart === null || entry.date >= windowStart),
);

/**
 * 区间总完成率 = 窗口内**全部任务**的完成比例，走 `stats.ts` 的 `daySummary`：
 *
 * 把窗口内的任务拼成一天的形状再交给它，是为了**借用它的分母护栏**
 * （`total === 0` 时 `rate` 固定为 0，永不 NaN）。`stats.ts` 没有「区间总完成率」
 * 这个函数，而本任务无权改动它，页面自己再写一遍 `done / total` 就成了第二份
 * 需要单独维护的除法——两处口径一旦分叉，页面照样构建成功，只有人眼看得出来。
 *
 * 传进去的 `date` 只是满足类型（`daySummary` 不使用日期）。
 */
const overall = daySummary({
  date: todayKey,
  tasks: windowEntries.flatMap((entry) => entry.tasks),
});

/** 0..1 的比值 → 不带小数的百分数。`rate` 只会是 0..1，这里仍夹一道以防坏输入。 */
function percent(rate: number): string {
  const value = Number.isFinite(rate) ? Math.max(0, Math.min(1, rate)) : 0;
  return `${Math.round(value * 100)}%`;
}

/* ---------------- 二、连续打卡 ---------------- */

const streakDays = streak(entries, todayKey);

/* ---------------- 三、近 12 周每周完成数 ---------------- */

const WEEKS = 12;

/**
 * 柱底标签取周一的 `月/日`。
 *
 * 不用 `formatMedium()`：它输出「10月26日 周一」，在三十几像素宽的柱位里根本放不下，
 * 12 根柱子会糊成一片。图上只需要能认出「这是哪一周」，完整日期在下面
 * 仅供读屏的表格里由同一份 `label` 承载——所以这里刻意选最短的可辨识写法。
 */
function weekLabel(weekStart: string): string {
  const { m, d } = parseDateKey(weekStart);
  return `${m}/${d}`;
}

const weekBars = weeklyDone(entries, todayKey, WEEKS).map((week) => ({
  label: weekLabel(week.weekStart),
  value: week.done,
}));

/* ---------------- 四、90 天完成率折线 ---------------- */

const TREND_DAYS = 90;

/**
 * 90 天窗口里**有没有任何一天留下记录**。
 *
 * 这个判断必须在这里做，不能指望 `LineChart`：`rollingRate()` 无论有没有数据都
 * 返回 `days` 个点（无记录的日子是 0%），所以把它的结果原样传下去，空数据的站点会
 * 得到一条紧贴底边的 0% 直线——那既不是空状态，也不是真话：读者会以为「这三个月
 * 一件事都没做成」，而实际上这三个月**什么都没写**。两件事完全不同。
 *
 * 有记录但一条没完成的日子不算空：那时 0% 是实情，线就该贴着底走。
 */
const trendWindowStart = addDays(todayKey, -(TREND_DAYS - 1));
const trendHasData = entries.some(
  (entry) => entry.date >= trendWindowStart && entry.date <= todayKey && entry.tasks.length > 0,
);

/**
 * 传给折线图的是 `formatLong()` 的写法（「2026年7月31日 周五」）。
 *
 * 为什么带年份：90 天窗口在每年头三个月里都会跨年（1 月往前数 90 天是去年 10 月），
 * `formatMedium()` 那种不带年份的写法在跨年那段会把去年和今年混成一天。
 * 为什么不是 ISO 的 `YYYY-MM-DD`：那是机器写法，一本中文簿子的轴上不该出现它。
 *
 * 图上只用到首尾两个标签，`formatLong` 的长度在 360 单位的画布上放得下（左标签从 30
 * 起、右标签贴着 354 收尾，中间还空着一大段），不会叠字。
 */
const trendPoints = trendHasData
  ? rollingRate(entries, todayKey, TREND_DAYS).map((point) => ({
      x: formatLong(point.date),
      y: point.rate,
    }))
  : [];

/* ---------------- 排版常量：四块共用，改一处就够 ---------------- */

/** 大数字：字大、行高压紧、等宽数字（两位百分数不会跳动，也不会与下面那行对不齐）。 */
const BIG_NUMBER_CLASS =
  'text-[2.5rem] leading-none font-semibold tabular-nums tracking-[-0.02em] text-foreground';
/** 区块小标题。 */
const SECTION_HEADING_CLASS =
  'text-[0.8125rem] font-medium tracking-[-0.01em] text-muted-foreground';
/** 大数字下面那句说明。 */
const SECTION_NOTE_CLASS = 'mt-2 text-[0.8125rem] text-muted-foreground';
/** 图表下面那句说明（两个图的说明里都有「一格/一个点」这类读图提示）。 */
const CHART_NOTE_CLASS = 'mt-2 text-[0.8125rem] text-muted-foreground';
---

<BaseLayout title="统计" activeNav="stats">
  <header class="pb-7">
    <h1 class="text-[1.375rem] font-semibold tracking-[-0.01em] text-foreground">统计</h1>
    <p class="mt-1.5 text-[0.8125rem] text-muted-foreground">
      只数完成情况：划掉了多少、连着多少天、最近几周的走势。不列出事项本身。
    </p>
    <p class="mt-1 text-[0.8125rem] tabular-nums text-muted-foreground">
      截至 {formatLong(todayKey)}
    </p>
  </header>

  {
    showCompletionRate ? (
      <section aria-labelledby="rate-heading" class="border-t border-border py-6">
        <h2 id="rate-heading" class={SECTION_HEADING_CLASS}>总完成率</h2>

        {overall.total === 0 ? (
          <div class="mt-3">
            <EmptyState
              title={`${windowLabel}还没有可统计的事项`}
              hint="写下一天、再划掉几条之后，这里会出现一个百分比。"
            />
          </div>
        ) : (
          <div class="mt-2">
            <p class={BIG_NUMBER_CLASS}>{percent(overall.rate)}</p>
            <p class={`${SECTION_NOTE_CLASS} tabular-nums`}>
              {windowLabel}的 {overall.total} 条事项里，划掉了 {overall.done} 条。
            </p>
          </div>
        )}
      </section>
    ) : null
  }

  {
    showStreak ? (
      <section aria-labelledby="streak-heading" class="border-t border-border py-6">
        <h2 id="streak-heading" class={SECTION_HEADING_CLASS}>连续打卡</h2>

        {entries.length === 0 ? (
          <div class="mt-3">
            <EmptyState
              title="还没有可以数的天数"
              hint="某一天的事项全部划掉，连续天数就从那一天开始数。"
            />
          </div>
        ) : (
          <div class="mt-2">
            <p class={BIG_NUMBER_CLASS}>
              {streakDays}
              <span class="ml-1 text-[1rem] font-normal text-muted-foreground">天</span>
            </p>
            {/*
              0 天不是「空数据」而是「链条断了」，所以照样把数字摆出来，只把话说清楚。
              零任务的一天既不计入也不断链（见 `stats.ts`），所以这里也不提「休息日」
              ——那是模块的既定边界，不归本页解释。
            */}
            <p class={SECTION_NOTE_CLASS}>
              {
                streakDays > 0
                  ? '从今天往回数，这些天的事项都划完了。'
                  : '还没有连成串。把某一天的事项全部划掉，就从那一天开始数。'
              }
            </p>
          </div>
        )}
      </section>
    ) : null
  }

  {/*
    趋势开关同时管两张图：柱状是「每周完成了多少件」，折线是「每天完成了多少成」，
    它们讲的是同一件事（trend），关掉只留一个会让人以为另一半数据不存在。
    两张图各有自己的空状态，所以这里不需要替它们判断「有没有数据」。
  */}
  {
    showTrend ? (
      <section aria-labelledby="weekly-heading" class="border-t border-border py-6">
        <h2 id="weekly-heading" class={SECTION_HEADING_CLASS}>近 12 周每周完成数</h2>

        <div class="mt-3">
          <BarSquares data={weekBars} />
        </div>

        <p class={CHART_NOTE_CLASS}>一格一件事。最后一条是本周（周一起算）。</p>
      </section>
    ) : null
  }

  {
    showTrend ? (
      <section aria-labelledby="trend-heading" class="border-t border-border py-6">
        <h2 id="trend-heading" class={SECTION_HEADING_CLASS}>近 90 天每天完成率</h2>

        <div class="mt-3">
          {/*
            没有记录的日子是 0%，不是「断开」——`rollingRate` 就是这么给的，
            这条线因此能贴着底走完整段。这一点必须写在页面上，否则一段贴底的
            直线会被误读成「那段时间什么都没做」。
          */}
          <LineChart points={trendPoints} />
        </div>

        <p class={CHART_NOTE_CLASS}>每天一个点：当天完成了几成。没有记录的日子按 0% 算。</p>
      </section>
    ) : null
  }

  {/* 三个开关全关时，页面上只剩页首——与其让人对着一张空白猜，不如说明这是配置。 */}
  {
    !showCompletionRate && !showStreak && !showTrend ? (
      <EmptyState
        title="统计项目前都关掉了"
        hint="frontend.stats 里的三个开关（完成率、连续打卡、趋势）都关着，这一页暂时没有内容。"
      />
    ) : null
  }
</BaseLayout>
