---
import '../styles/global.css';
import GlobalStyles from '../components/GlobalStyles.astro';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';
import TopBar from '../components/TopBar.astro';
import type { NavKey } from '../lib/types';
import { withBase } from '../lib/urls';
import { siteConfig } from '../../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  activeNav?: NavKey;
  /**
   * canonical 的显式覆盖，取值是**已含 base 的站内路径**（如 `withBase('/')`）。
   *
   * 只给内容重复的页面用：`/date/<今天>` 与 `/` 渲染同一天，规范地址必须指回 `/`，
   * 否则同一份内容有两个可索引的 URL。其余页面留空，按当前 pathname 自己算。
   */
  canonicalHref?: string;
  /**
   * 预取目标（**已含 base 的站内路径**），渲染成 `<link rel="prefetch">`。
   *
   * 为什么用 `<link>` 而不是 Astro 的 `prefetch` 配置或浏览器 Speculation Rules：
   * 前两者都要往页面里塞一段**脚本**，而公开页的硬约束是零外链 JS、内联脚本 ≤2 段。
   * `<link rel="prefetch">` 是纯声明，浏览器在空闲时低优先级拉一次，点过去时命中的
   * 就是本地缓存——这是「零 JS 也接近无刷新」的极限做法。
   *
   * 只给**很可能被点**的目标（相邻日、回到今天），不给五个导航项全铺：
   * 每次打开都多拉几十 KB、而用户从不点，那是净浪费。
   */
  prefetch?: string[];
}

const { title, description = siteConfig.site.tagline, activeNav, canonicalHref, prefetch = [] } =
  Astro.props;

const pageTitle = title ? `${title}｜${siteConfig.site.title}` : siteConfig.site.title;
// canonical 由 site.url + 当前 pathname 拼出。pathname 已含 base，
// 所以 GH Pages 子路径部署时 canonical 自动跟着走，不需要在这里判断 basePath。
const canonical = new URL(canonicalHref ?? Astro.url.pathname, siteConfig.site.url).href;
---

<!doctype html>
<html lang={siteConfig.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <!--
      图标是内联 SVG 文件，随 base 一起走（GH Pages 子路径下不能写死 /favicon.svg）。
      必须经 `withBase` 而不是 `${import.meta.env.BASE_URL}favicon.svg`：Astro 7 的
      BASE_URL 是**不带尾斜杠**的 `/repo`，直接拼接会得到 `/repofavicon.svg`——
      子路径部署下图标 404，而且这种 404 只有打开 DevTools 才看得见。
    -->
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {/* PWA：清单 + 主屏图标 + 浏览器 UI 着色（纸色/暗色，与 global.css 令牌一致）。 */}
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#f6f3ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16181a" media="(prefers-color-scheme: dark)" />
    {/*
      PWA 两件套（公开页专属——admin 不用 BaseLayout，天然不注册 SW）：
      1. 注册 SW（swpp 生成到 dist 根，URL = `${base}/sw.js`）。失败静默：SW 挂了
         绝不影响看内容。为什么用 define:vars 注入 URL：站内路径必须走 withBase。
         写成单行压缩形态是因为 define:vars 会让 Astro 放弃脚本压缩，格式化源码
         会白吃几百字节预算。
      2. swpp 的 DOM 侧脚本 `sw-dom.js`（defer）：页面加载后 postMessage 通知 SW
         做增量更新（10 分钟冷却，UPDATE_CD）。脚本自身在没有 controller
         （首次访问）时立即退出。
    */}
    <script is:inline define:vars={{ swUrl: withBase('/sw.js') }}>
      if('serviceWorker'in navigator)addEventListener('load',function(){navigator.serviceWorker.register(swUrl).catch(function(){})});
    </script>
    <script defer src={withBase('/sw-dom.js')}></script>
    {/* 预取：纯声明，零脚本。目标由 `lib/day-nav.ts` 的同一份判定算出（不会指向 404）。 */}
    {prefetch.map((href) => <link rel="prefetch" href={href} />)}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={siteConfig.site.lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {/* 首帧前定明暗的内联脚本：与后台外壳共用同一份源码（`ThemeBootstrap.astro`）。
        必须留在 `<head>` 里、第一次绘制前同步执行。 */}
    <ThemeBootstrap />
  </head>
  <body class="min-h-dvh bg-background">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:border focus:border-primary focus:bg-card focus:px-3 focus:py-2 focus:text-[0.8125rem] focus:text-foreground"
      >跳到正文</a
    >
    <TopBar activeNav={activeNav} />
    {/*
      shadcn dashboard 的内容容器：max-w-6xl（72rem）居中。
      1440 屏基本铺满，1920 屏左右各留 ~300px——那是 dashboard 比例的呼吸边，
      不再像 90rem 那样把每一页都撑成工作台，也不像 40rem 那样空出大片。
      「读」的长文（统计页说明）由页面自己用 PROSE_MEASURE 收窄。
    */}
    <main id="main" class="mx-auto w-full max-w-6xl px-4 pb-16 pt-8 sm:px-6">
      <slot />
    </main>
    {/* 焦点环 / 选区色 / 减少动效：与后台共用同一份源码（`GlobalStyles.astro`）。
        `<style is:global>` 会被 Astro 提升到 `<head>`，位置只影响样式表内的先后顺序。 */}
    <GlobalStyles />
  </body>
</html>
