---
import { Archive, BookOpen, CalendarDays, ChartLine, Lock, Tag } from '@lucide/astro';
import type { NavKey } from '../lib/types';
import { withBase } from '../lib/urls';
import { siteConfig } from '../../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  activeNav?: NavKey;
}

const { activeNav } = Astro.props;

/**
 * 导航项的顺序与图标写在这里；**是否出现只由 `siteConfig.frontend.pages` 决定**，
 * 配置里关掉的页面不出现在导航里。（`pages.day` 不是独立导航项：单日页归在今天之下。）
 */
const NAV_ITEMS = [
  { key: 'today', label: '今天', href: '/', Icon: BookOpen },
  { key: 'archive', label: '归档', href: '/archive', Icon: Archive },
  { key: 'calendar', label: '日历', href: '/calendar', Icon: CalendarDays },
  { key: 'tags', label: '标签', href: '/tags', Icon: Tag },
  { key: 'stats', label: '统计', href: '/stats', Icon: ChartLine },
] as const;

const pages = siteConfig.frontend.pages;
const items = NAV_ITEMS.filter((item) => pages[item.key]);

/** 后台入口：私人工具，路径仍以 `siteConfig.admin.path` 为唯一真相。 */
const adminHref = withBase(siteConfig.admin.path);
---

<!--
  顶栏（shadcn dashboard 外壳）：全宽 h-14、1px 下边框、半透明模糊。
  内层与正文容器同为 max-w-6xl 居中——品牌、导航与下方内容左右对齐。
  导航是药丸 tab：当前项 bg-muted（shadcn 的 Tabs / 触发器语汇），不是下划线。
  窄屏：品牌 + 明暗一行，导航折到第二行（药丸横向排列，允许换行）。
-->
<header
  class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur [view-transition-name:topbar]"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-5 gap-y-1 px-4 py-2 sm:px-6 lg:h-14 lg:flex-nowrap lg:py-0">
    <a
      href={withBase('/')}
      class="whitespace-nowrap text-[1.0625rem] font-semibold tracking-[-0.01em] text-foreground transition-colors hover:text-primary"
      >{siteConfig.site.title}</a
    >
    <p class="hidden min-w-0 max-w-[22rem] truncate text-[0.8125rem] text-muted-foreground md:block">
      {siteConfig.site.tagline}
    </p>

    <nav aria-label="主导航" class="flex flex-wrap items-center gap-1 lg:ms-auto">
      {
        items.map(({ key, label, href, Icon }) => {
          const isActive = activeNav === key;
          return (
            <a
              href={withBase(href)}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'flex items-center gap-1.5 whitespace-nowrap border-b-2 px-2.5 py-1.5 text-[0.875rem] transition-colors',
                isActive
                  ? 'border-seal font-medium text-foreground'
                  : 'border-transparent text-muted-foreground hover:text-foreground',
              ]}
            >
              <Icon size={15} stroke-width={1.75} class="shrink-0" aria-hidden="true" />
              <span>{label}</span>
            </a>
          );
        })
      }
      {/*
        后台入口：不是内容页，所以不跟五个 tab 争权重——一道细分隔线隔开，颜色降一档，
        悬停才提到正文色。`aria-current` 不参与：admin 页不继承 BaseLayout，没有 activeNav。
      */}
      <span aria-hidden="true" class="mx-1 h-4 w-px shrink-0 bg-border"></span>
      <a
        href={adminHref}
        class="flex items-center gap-1.5 whitespace-nowrap px-2.5 py-1.5 text-[0.875rem] text-muted-foreground transition-colors hover:text-foreground"
      >
        <Lock size={15} stroke-width={1.75} class="shrink-0" aria-hidden="true" />
        <span>后台</span>
      </a>
    </nav>

    <ThemeToggle />
  </div>
</header>
