---
import { Monitor, Moon, Sun } from '@lucide/astro';
---

<!--
  三态明暗切换：跟随系统 → 明亮 → 暗黑 → 跟随系统。
  三个状态的图标与文字都预先渲染在 DOM 里，显示哪一个只由 CSS 看 <html data-theme> 决定，
  所以点击后不必改任何属性（也就不会先闪一下再变）。图标与可见文字对 AT 隐藏，
  每个状态各带一句完整的 sr-only 文案，按钮的可访问名始终只有当前这一句。
-->
<button
  type="button"
  data-theme-toggle
  class="ml-auto flex shrink-0 items-center gap-2 whitespace-nowrap rounded-md p-2 text-[0.8125rem] text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground lg:ml-2"
>
  <span data-when="system" class="toggle-state">
    <Monitor size={15} stroke-width={1.75} aria-hidden="true" />
    <span class="toggle-label" aria-hidden="true">跟随系统</span>
    <span class="sr-only">明暗：跟随系统（点击切为明亮）</span>
  </span>
  <span data-when="light" class="toggle-state">
    <Sun size={15} stroke-width={1.75} aria-hidden="true" />
    <span class="toggle-label" aria-hidden="true">明亮</span>
    <span class="sr-only">明暗：明亮（点击切为暗黑）</span>
  </span>
  <span data-when="dark" class="toggle-state">
    <Moon size={15} stroke-width={1.75} aria-hidden="true" />
    <span class="toggle-label" aria-hidden="true">暗黑</span>
    <span class="sr-only">明暗：暗黑（点击切为跟随系统）</span>
  </span>
</button>

<!--
  全站第二段、也是最后一段内联 JS：不加载任何外部脚本。
  点一下按 系统 → 明亮 → 暗黑 → 系统 循环，并写 localStorage["todo.theme"]。
-->
<script is:inline>
  (function () {
    var d = document.documentElement,
      K = 'todo.theme',
      m = matchMedia('(prefers-color-scheme:dark)'),
      N = { system: 'light', light: 'dark', dark: 'system' };
    function read() {
      var v;
      try {
        v = localStorage.getItem(K);
      } catch (e) {}
      return v === 'light' || v === 'dark' ? v : 'system';
    }
    function apply() {
      var t = read(),
        k = t === 'dark' || (t === 'system' && m.matches);
      d.dataset.theme = t;
      d.classList.toggle('dark', k);
      d.style.colorScheme = k ? 'dark' : 'light';
    }
    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-theme-toggle]')) return;
      try {
        localStorage.setItem(K, N[read()]);
      } catch (e) {}
      apply();
    });
    m.addEventListener('change', function () {
      if (read() === 'system') apply();
    });
    apply();
  })();
</script>

<style>
  /* 三个态都预置在 DOM 里，只显示 <html data-theme> 对应的那一个。
     无脚本时回落到「跟随系统」，按钮文案依旧可读。 */
  .toggle-state {
    display: none;
    align-items: center;
    gap: 0.4rem;
  }
  :root:not([data-theme]) .toggle-state[data-when='system'],
  :root[data-theme='system'] .toggle-state[data-when='system'],
  :root[data-theme='light'] .toggle-state[data-when='light'],
  :root[data-theme='dark'] .toggle-state[data-when='dark'] {
    display: inline-flex;
  }

  /* 状态词只在桌面顶栏露出；窄屏只留图标，省位置 */
  .toggle-label {
    display: none;
  }
  @media (min-width: 1024px) {
    .toggle-label {
      display: inline;
    }
  }
</style>
