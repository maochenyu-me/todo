---
/**
 * 标签索引：一排标签链接，最多 `maxVisible` 个（`collectTags` 已经截断好）。
 *
 * `/tags` 与 `/tags/[tag]` 共用这一份——两处的索引必须是同一批链接、同一个顺序，
 * 否则读者从索引点进某个标签后，回来看到的索引可能少了一项、或者顺序变了。
 *
 * 链接一律经 `tagPath()`（内部先 `encodeURIComponent` 再 `withBase`）：
 * 标签是中文、可能带空格或标点，不编码的话空格会被当成边界、`#` 会把后面变成 fragment。
 */
import { tagPath } from '../lib/tags';
import type { TagCount } from '../lib/tags';

interface Props {
  tags: TagCount[];
  /** 当前所在标签；索引里对应的那一项标成 `aria-current="page"`。 */
  currentTag?: string;
}

const { tags, currentTag } = Astro.props;
---

<nav aria-labelledby="tag-index-heading" class="pb-7">
  <h2 id="tag-index-heading" class="pb-2 text-[0.8125rem] text-muted-foreground">全部标签</h2>
  <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
    {
      tags.map(({ tag, count }) => {
        const isCurrent = tag === currentTag;
        return (
          <li>
            <a
              href={tagPath(tag)}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'inline-flex items-baseline gap-1 text-[0.875rem] underline-offset-4 transition-colors hover:underline',
                isCurrent
                  ? 'font-medium text-foreground'
                  : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              <span>#{tag}</span>
              <span class="text-[0.75rem] tabular-nums text-muted-foreground">{count}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
