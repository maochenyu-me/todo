---
/**
 * 一天的内容：印章 + 刻度进度 + 任务列表 + 前一天/后一天。
 *
 * `/`（今天）与 `/date/[date]`（任意一天）共用这一份版式——spec 规定两者「同布局」，
 * 页面上唯一的差别在 `<head>`（canonical／title），那是页面自己的事，不在这里。
 *
 * **一天的事全在一张表里**：已完成的任务照样留在原位，只是被 `TaskRow` 划掉。
 * 早先版本把已完成收进底部「已完成 N」折叠组，代价是「今天全做完了」的那一天
 * 主列表空着、读者要点一下才看得见自己做到了什么——这正是这个页面存在的意义，
 * 所以取消折叠组。顺序只按日程，不按完成状态重排：完成与否不该把一天的时序打乱。
 *
 * 本组件**只在构建期渲染**：零 `<script>`、零 `client:*`、零 hydration。
 */
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import DateStamp from './DateStamp.astro';
import EmptyState from './EmptyState.astro';
import ProgressTicks from './ProgressTicks.astro';
import TaskRow from './TaskRow.astro';
import { addDays, formatMedium } from '../lib/date';
import { dayNav } from '../lib/day-nav';
import { orderTasks } from '../lib/order';
import { capTasks } from '../lib/paging';
import { daySummary } from '../lib/stats';
import type { DayEntry, Task } from '../lib/types';
import { siteConfig } from '../../site.config.ts';

interface Props {
  dateKey: string;
  /** 该日没有文件时为 `null`；有文件但 `tasks` 为空是另一种「空」，两者都走空状态。 */
  entry: DayEntry | null;
  /**
   * 这一天**有文件但读不出来**（坏 JSON、内容不合法）。
   *
   * 必须与「没有这一天」分开渲染：`entry` 在两种情况下都是 `null`，若不加这个标记，
   * 页面就会对着一个坏文件说「今天还没有写下任何事」——那是假话。
   * 由页面用 `dayFileState()` 判定后传进来。
   */
  corrupt?: boolean;
  /** 相邻那天在磁盘上有没有记录——没有就置灰，不发死链。 */
  prevHasData: boolean;
  nextHasData: boolean;
  /** 「今天」的唯一依据，由页面按 `siteConfig.site.timeZone` 算好传进来。 */
  todayKey: string;
}

const { dateKey, entry, corrupt = false, prevHasData, nextHasData, todayKey } = Astro.props;

const { showTimeBlock, showTags, showPriority, maxTasksPerPage } = siteConfig.frontend;

const isToday = dateKey === todayKey;

/**
 * 防御：`corrupt` 与「有任务可渲染」**互斥**。
 *
 * 页面的两个判定来自两条独立调用（`entry = readDayFromDisk(...)` 与
 * `corrupt = dayFileState(...) === 'corrupt'`），`data.ts` 已保证两者不会分叉
 * （见 `dayFileState` 的「不变量」一节并有测试钉住）。但这里再加一道结构性的闸：
 * 只要真能拿到条目，就**不可能**同时显示「记录读不出来」的横幅——
 * 那会是一句自相矛盾的话，而且是最难被测试抓到的那种（页面照样构建成功）。
 *
 * 若两道防线中的任何一道将来被改坏，这里选择相信**数据**而不是标记：
 * `corrupt` 降级为 `false`，页面变成正常的一页。理由是宁可少一句诊断，
 * 也不能出现「边说读不出来边把内容列出来」的页面。
 */
const hasTasks = (entry?.tasks.length ?? 0) > 0;
const isCorrupt = corrupt && !hasTasks;

const tasks: Task[] = entry?.tasks ?? [];
const summary = daySummary({ date: dateKey, tasks });

// 读者所见顺序：先有 `timeBlock` 的按开始时间，再没有 `timeBlock` 的按 `order`。
// 只按时间排，**不**按完成状态分组：完成的那条留在它本该在的时刻上，
// 否则一个划掉的上午事项会被挤到下午未完成事项的下面，这一天就读不出先后了。
const { scheduled, unscheduled } = orderTasks(tasks);
const readerOrder = [...scheduled, ...unscheduled];

// maxTasksPerPage 是护栏而不是排版目标：超了就只渲染前 N 条，并如实报出还剩多少条。
// 上限非正数/非有限值时 `capTasks` 视作「不限」并用 `cap: null` 表示，绝不会说出「（0 条）」。
// 计数口径是**合并后的单一列表**（`readerOrder` 就是最终顺序，不再拆开/合并），
// 所以「另有 N 条」与页面上真实少掉的行数一致。
const { shown, hidden: hiddenCount, cap } = capTasks(readerOrder, maxTasksPerPage);

const isEmpty = tasks.length === 0;

const prevKey = addDays(dateKey, -1);
const nextKey = addDays(dateKey, 1);

/*
 * 翻阅链接的口径统一走 `dayNav()`：它和页面的 `<link rel=prefetch>` 是**同一份判定**，
 * 所以不可能出现「翻页有链接、预取没有」或者「预取了一个 404」。
 * 相邻那天是今天时即便没有文件也链（今天的地址是 `/`）——曾在这里断过路：
 * 从昨天往回按「下一天」是灰的，读者回不到今天。
 */
const nav = dayNav({ dateKey, todayKey, prevHasData, nextHasData });

const emptyTitle = isToday ? '今天还没有写下任何事' : '这一天没有留下任何记录';
const emptyHint = isToday ? '从三件小事开始，写完再一条条划掉。' : '空白的一天，也算如实记录。';

/**
 * 刻度的空态文案。`ProgressTicks` 的默认值是「今天还没有条目」，只对今天成立，
 * 所以过去的日子必须换一句；读不出来的那天连条数都不知道，也不能说「没有条目」。
 */
const ticksEmptyLabel = isCorrupt
  ? '记录读不出来，进度未知'
  : isToday
    ? undefined
    : '这一天没有条目';
---

<!--
  根元素包一层 div，同时它是**纸上的一页**：1px 纸边、无圆角、无阴影（纸是平的），
  左侧一条极淡的红色页边线——横线信纸的那道竖线，也是「这一页」的起点。
  本组件模板曾是多根（页首/列表/翻页），Astro 会把多根组件摊平成父容器的直接子元素
  ——进 grid 时会被当成多个格子（实测踩过：任务列表被甩到右列），包一层之后
  整个 DayView 是布局里的**一个**元素。
-->
<div
  class="relative border border-border bg-card before:absolute before:inset-y-0 before:left-4 before:w-px before:bg-seal/20"
>
  <!-- 页首：印章 ＋ 刻度，全部左对齐。印章是页面上唯一倾斜的东西。 -->
  <header class="flex flex-wrap items-end gap-x-7 gap-y-5 p-6 pb-5 sm:p-8 sm:pb-5">
  <DateStamp dateKey={dateKey} />
  <div class="pb-1.5">
    <ProgressTicks total={summary.total} done={summary.done} emptyLabel={ticksEmptyLabel} />
  </div>
</header>

<section aria-labelledby="day-heading" class="px-6 sm:px-8">
  <h2 id="day-heading" class="sr-only">{isToday ? '今天的待办' : '这一天的待办'}</h2>

  {
    isCorrupt ? (
      <EmptyState
        title={isToday ? '今天的记录在，但读不出来' : '这一天的记录在，但读不出来'}
        hint="数据文件存在，但内容不合法或无法解析。修好那个文件后重新构建即可恢复。"
      />
    ) : null
  }

  {isEmpty && !isCorrupt ? <EmptyState title={emptyTitle} hint={emptyHint} /> : null}

  {
    shown.length > 0 ? (
      <div>
        {/* 列头：只列真实存在的列。showTimeBlock 关掉时不留「时间」标题与空槽。 */}
        <div
          class="flex gap-x-2.5 border-b border-border pb-1.5 text-[0.8125rem] text-muted-foreground max-sm:hidden"
          aria-hidden="true"
        >
          {showTimeBlock ? <span class="w-[5.25rem] shrink-0">时间</span> : null}
          <span class="w-[13px] shrink-0" />
          <span>事项</span>
        </div>
        <ul>
          {shown.map((task) => (
            <TaskRow
              task={task}
              showTimeBlock={showTimeBlock}
              showTags={showTags}
              showPriority={showPriority}
            />
          ))}
        </ul>
      </div>
    ) : null
  }

  {/*
    这里原先还有一句「今天的事项都划掉了。」用来顶替空掉的主列表。
    完成的事项现在就在上面的列表里，那句话只剩「这一天零任务」时才可能成立——
    而那种情况已经由 EmptyState 说了「今天还没有写下任何事」（或「这一天没有留下任何记录」）。
    同一件事说两遍、两种说法，只会互相打脸，所以整句删掉，不保留为死代码。
  */}

  {/* 超出单页上限时如实告知，不静默截断。`cap` 为 `null` 表示未设上限，此句不会出现。 */}
  {
    hiddenCount > 0 && cap !== null ? (
      <p class="mt-7 text-[0.8125rem] text-muted-foreground">
        另有 {hiddenCount} 条超出单页显示上限（{cap} 条），此处未显示。
      </p>
    ) : null
  }
</section>

<!--
  卡片页脚：相邻两天「有记录或就是今天」才是链接（判定来自 `dayNav()`，与预取同一份）。
  不满足的那一侧渲染成 span —— 不可聚焦、不会被 TAB 走到、点了也没反应，
  但读屏仍能报出日期与「暂无记录」，读者知道那是哪一天、为什么点不动。
  不是今天的日子在中间给一颗「回到今天」：翻进历史之后，出路不该依赖
  读者记得顶栏上还有个「今天」。
-->
<nav
  aria-label="按日翻阅"
  class="mt-8 flex items-center justify-between gap-3 border-t border-line bg-muted/40 px-6 py-4 text-[0.8125rem] sm:px-8"
>
  {
    nav.prev !== null ? (
      <a
        href={nav.prev}
        class="inline-flex items-center gap-0.5 text-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
      >
        <ChevronLeft size={14} stroke-width={1.75} aria-hidden="true" />
        <span>{formatMedium(prevKey)}</span>
      </a>
    ) : (
      <span aria-disabled="true" class="inline-flex items-center gap-0.5 text-muted-foreground">
        <ChevronLeft size={14} stroke-width={1.75} aria-hidden="true" />
        <span>{formatMedium(prevKey)}</span>
        <span class="sr-only">暂无记录</span>
      </span>
    )
  }
  {
    nav.today !== null ? (
      <a
        href={nav.today}
        class="shrink-0 text-muted-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
      >
        回到今天
      </a>
    ) : null
  }
  {
    nav.next !== null ? (
      <a
        href={nav.next}
        class="inline-flex items-center gap-0.5 text-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
      >
        <span>{formatMedium(nextKey)}</span>
        <ChevronRight size={14} stroke-width={1.75} aria-hidden="true" />
      </a>
    ) : (
      <span aria-disabled="true" class="inline-flex items-center gap-0.5 text-muted-foreground">
        <span>{formatMedium(nextKey)}</span>
        <span class="sr-only">暂无记录</span>
        <ChevronRight size={14} stroke-width={1.75} aria-hidden="true" />
      </span>
    )
  }
</nav>
</div>
