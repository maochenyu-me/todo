---
/**
 * 柱状图：柱子由**竖排的小方块**堆成，一格 = 一个单位。
 *
 * 为什么是方块而不是一根实心柱：这本簿子的语汇是「数格子」——首页与归档的进度条
 * 就是一排小方块（`ProgressTicks`）。统计页的柱子沿用同一套语汇，读者不必在两套
 * 图形语言之间切换，而且方块能**数**出来：一周比上周多做三件事，多出来的就是三格。
 *
 * 画法约束（与设计稿一致，改前请三思）：无渐变、无阴影、无光晕、无圆点；
 * 颜色只取设计令牌（`--foreground` 的墨色 + `--border` 的格线），**不出现任何十六进制**。
 *
 * 本组件零逻辑：画法全部由 `planBars()` 算好（护栏、夹取、坐标、空态判定都在
 * `src/lib/chart.ts` 有单测）。与 `ProgressTicks` 消费 `planTicks()` 是同一套分工。
 *
 * 零 JS：只产出静态内联 `<svg>`，没有 `<script>`、没有 `client:*`。
 *
 * ## 尺寸：1:1 渲染，窄屏横向滚动，不缩放
 *
 * 画布按**用户单位 = 像素**输出（`width`/`height` 属性就是自然尺寸），所以轴文字
 * 的字号就是它渲染出来的像素数：12/11px，在 320px 宽的手机上也读得清。
 *
 * 12 根柱子在 320px 屏上放不下（内容区约 280px），这里**不缩小**（缩小会把 12px
 * 压成 7.8px），而是让外层 `overflow-x-auto` 横向滚动：读者左右滑一下就能看全，
 * 文字始终是 12px。宽屏上画布保持自然宽度、不留 `max-h` 造成的空档。
 *
 * 柱位宽度不是写死的 36：`planBars()` 按**实际标签宽度**算
 * `max(36, 最宽标签 + 缝)`，标签换成更宽的写法也不会与邻居撞字。
 */
import EmptyState from '../EmptyState.astro';
import { BAR_GEOMETRY, planBars } from '../../lib/chart';

interface Props {
  /** 一根柱子一项。`label` 是柱底文字（写法由调用方决定），`value` 是**单位个数**。 */
  data: { label: string; value: number }[];
  /**
   * 纵轴顶端画到几格高。缺省取数据最大值。
   *
   * 显式传入时：比它高的柱子会被夹到顶端（宁可少画，也不越出画布），
   * 非正数 / `NaN` / `Infinity` 视为「没传」——与本仓 `ticks.ts`、`paging.ts`
   * 对上限归一化的口径一致。
   */
  max?: number;
}

const { data, max } = Astro.props;

const plan = planBars({ data, max });

/**
 * 图形的可访问名。
 *
 * 说清四件事：这是什么图、覆盖哪一段、一共几项、一格代表多少，以及**最高多少**。
 * 这里的「最高」用的是 `plan.peak`——真实峰值。护栏（`plan.drawRows`）是画法细节，
 * 不是数据事实，绝不能写进这句话里：读者要知道的是「最多的一周做了 1400 件」，
 * 而不是「我最多画了 40 格」。
 */
const ariaLabel = [
  `柱状图：从 ${plan.rows[0]?.label ?? ''} 到 ${plan.rows[plan.rows.length - 1]?.label ?? ''}`,
  `共 ${plan.rows.length} 项的完成数`,
  '每格代表 1',
  `最高 ${plan.peak}`,
  plan.clipped ? `超过 ${plan.drawRows} 格的柱子画到顶端、柱顶标出真实数值` : '',
]
  .filter((part) => part !== '')
  .join('，');
---

{
  !plan.hasUnits ? (
    <EmptyState
      title="还没有可以立的柱子"
      hint="这段时间里没有完成记录。写下几天，再把它们一条条划掉，柱子就会长出来。"
    />
  ) : (
    <div>
      {/*
        窄屏横向滚动容器：见文件头「尺寸」一节。

        键盘与读屏都要能到达这里：可滚动区域默认不一定拿得到焦点（浏览器行为不一致），
        所以显式 `tabindex="0"` + `role="group"` + 中文名。名字说清「这是什么」而不是
        「滚动我」——读屏读到的应该是图表的身份，不是控件说明书。
      */}
      <div
        class="overflow-x-auto"
        tabindex="0"
        role="group"
        aria-label={`近 12 周每周完成数柱状图，宽 ${plan.width} 像素，窄屏可左右滚动`}
      >
        <svg
          role="img"
          aria-label={ariaLabel}
          viewBox={`0 0 ${plan.width} ${plan.height}`}
          width={plan.width}
          height={plan.height}
          class="block max-w-none text-foreground"
        >
          {plan.squares.map((square) => (
            <rect
              x={square.x}
              y={square.y}
              width={BAR_GEOMETRY.square}
              height={BAR_GEOMETRY.square}
              fill="currentColor"
            />
          ))}

          <line
            x1="0"
            y1={plan.baseline}
            x2={plan.width}
            y2={plan.baseline}
            class="text-border"
            stroke="currentColor"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />

          {/*
            被夹住的柱子在**柱顶写出真实数值**。

            这是护栏能成立的前提：40 格与 1400 格画出来一样高，光看形状分不出
            「写了两页待办的一周」和「只做了四十件事的一周」。数字一写上去，
            图形负责「大概多高」，文字负责「到底多少」，两件事各归各位。
          */}
          {plan.showValues
            ? plan.rows
                .filter((row) => row.clipped)
                .map((row) => (
                  <text
                    x={row.centerX}
                    y={row.topY - 4}
                    text-anchor="middle"
                    font-size={BAR_GEOMETRY.valueFont}
                    class="text-foreground"
                    fill="currentColor"
                  >
                    {row.value}
                  </text>
                ))
            : null}

          {plan.rows.map((row) => (
            <text
              x={row.centerX}
              y={plan.baseline + BAR_GEOMETRY.axisGap + BAR_GEOMETRY.labelHeight - 4}
              text-anchor="middle"
              font-size={BAR_GEOMETRY.axisFont}
              class="text-muted-foreground"
              fill="currentColor"
            >
              {row.label}
            </text>
          ))}
        </svg>
      </div>

      {/*
        读屏拿到的必须是数字，不是一个形状：`role="img"` 的图形本身不朗读内容，
        每一项都在这张表里逐条列着。

        平时对视力读者隐藏（柱子的形状已经说明了问题，再列一遍是重复）；
        但柱子被封顶时**改成可见**——那一刻图形已经不能说清「到底多少」，
        数字必须自己站出来。两种情况下读屏拿到的内容完全一样。
      */}
      <table class={plan.clipped ? 'mt-3 w-full text-[0.8125rem] tabular-nums' : 'sr-only'}>
        <caption
          class:list={[plan.clipped ? 'mb-1 text-left text-[0.75rem] text-muted-foreground' : null]}
        >
          图表数值：共 {plan.rows.length} 项，最高 {plan.peak}
          {plan.clipped ? `；柱子最多画 ${plan.drawRows} 格，更高的柱子柱顶标了真实数` : ''}
        </caption>

        <thead class:list={[plan.clipped ? 'text-[0.75rem] text-muted-foreground' : null]}>
          <tr>
            <th scope="col" class:list={[plan.clipped ? 'py-1 text-left font-normal' : null]}>项</th>
            <th scope="col" class:list={[plan.clipped ? 'py-1 text-right font-normal' : null]}>
              数值
            </th>
          </tr>
        </thead>
        <tbody>
          {plan.rows.map((row) => (
            <tr class:list={[plan.clipped ? 'border-t border-border/70' : null]}>
              <th scope="row" class:list={[plan.clipped ? 'py-1 text-left font-normal' : null]}>
                {row.label}
              </th>
              <td class:list={[plan.clipped ? 'py-1 text-right' : null]}>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
