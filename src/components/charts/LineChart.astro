---
/**
 * 折线图：一条 1.5px 的墨线，仅此而已。
 *
 * 画法约束（与设计稿一致，改前请三思）：**无区域填充、无阴影、无装饰圆点**。
 * 折线只表达「走势」，具体某天是多少，看文字列表；加上圆点会让人以为那些点
 * 是可以点或值得逐个读的，而这张图上唯一可靠的东西是整条线的方向。
 * 颜色只取设计令牌（`--foreground` 的墨色、`--border` 的轴线），**不出现任何十六进制**。
 *
 * 本组件零逻辑：坐标、路径、首尾标签、空态判定全部由 `planLine()` 算好
 * （除零、越界、单点退化都在 `src/lib/chart.ts` 有单测）。
 *
 * 零 JS：只产出静态内联 `<svg>`，没有 `<script>`、没有 `client:*`。
 *
 * ## 尺寸：1:1 渲染，窄屏横向滚动，不缩放
 *
 * 画布输出 `width`/`height` 属性的自然尺寸（缺省 `LINE_GEOMETRY.width` = 320 用户单位，
 * 宽容器可由调用方传入更大的 `width`，口径与 `BarSquares` 相同：只加宽不缩窄）。
 * 外层是横向滚动容器：容器比画布窄时左右滑动看全，**不做等比缩放**——
 * 缩放会把 14px 的轴字按容器比例压小（320 画布在 280px 内容区上就已只剩 12.25px），
 * 宽画布下更没法看。宽屏上画布按传入宽度 1:1 铺满，轴文字纹丝不动。
 * 文字不许被裁：几何留白是被字宽算出来的
 *
 * SVG 不会替你换行或撑开画布，超出 viewBox 的文字是**静默裁掉**的。所以左边距与
 * 首尾标签的处理都由 `planLine()` 用 `advanceEm()` 量过：
 * - `yLabelFits`：纵轴 `100%` 装得进 `padLeft - yLabelGap`；
 * - `xLabelsFit`：首尾两个日期装得进绘图区。装不下时**只画尾部那个**——
 *   「到哪天为止」比「从哪天开始」重要，完整范围仍在 aria-label 与表格里。
 */
import EmptyState from '../EmptyState.astro';
import { LINE_GEOMETRY, planLine } from '../../lib/chart';

interface Props {
  /**
   * 采样点，按时间顺序。`x` 是原样显示的横轴文字（由调用方决定写法），
   * `y` 是**比例值 0..1**（如完成率），不是百分数。
   */
  points: { x: string; y: number }[];
  /** 画布高度（像素）。缺省 120；非法值回落到 120，超出 60..320 的夹进区间。 */
  height?: number;
  /**
   * 目标画布宽度（像素）。缺省＝自然宽度（`LINE_GEOMETRY.width` = 320）。
   *
   * 与 `BarSquares` 的 `width` 同口径：**只加宽、绝不缩窄**。加宽摊开的是采样点
   * 的横轴步距，轴文字仍是 14px 用户单位、1:1 渲染——所以宽容器上传入目标宽度
   * 能铺满整列而不放大字号（统计页的用法）。
   *
   * 画布比容器窄时靠外层横向滚动兜底（与柱状图同一套），**不做等比缩放**：
   * 缩放会把 14px 的轴字压到读不清（320 时代的「只缩不放」注的就是这个）。
   */
  width?: number;
}

const { points, height, width } = Astro.props;

const plan = planLine({ points, height, width });

/** 图形可访问名：覆盖范围、点数、纵轴口径。具体读数在下面的表格里。 */
const ariaLabel =
  `折线图：从 ${plan.firstLabel} 到 ${plan.lastLabel} 共 ${plan.samples.length} 个点` +
  '的每日完成率，纵轴 0% 到 100%';
---

{
  !plan.hasPoints ? (
    <EmptyState
      title="还没有可以连成线的点"
      hint="这段时间里没有可以计算的完成率。写下几天，这条线就会从左边开始长。"
    />
  ) : (
    <div>
      {/*
        横向滚动容器（与 `BarSquares` 同一套兜底）：画布 1:1 渲染，容器比画布窄时
        左右滑动看全，轴文字始终保持 14px。可滚动区域显式 `tabindex="0"` +
        `role="group"` + 中文名，键盘与读屏都要能到达。
      */}
      <div
        class="overflow-x-auto"
        tabindex="0"
        role="group"
        aria-label={`近 90 天完成率折线图，宽 ${plan.width} 像素，窄屏可左右滚动`}
      >
        <svg
          role="img"
          aria-label={ariaLabel}
          viewBox={`0 0 ${plan.width} ${plan.height}`}
          width={plan.width}
          height={plan.height}
          class="block max-w-none text-foreground"
        >
        {/* 轴：底边一条横线，左边一条竖线。纯 <line>，没有刻度线阵。 */}
        <line
          x1={plan.plotLeft}
          y1={plan.baselineY}
          x2={plan.plotLeft + plan.plotWidth}
          y2={plan.baselineY}
          class="text-border"
          stroke="currentColor"
          stroke-width="1"
          vector-effect="non-scaling-stroke"
        />
        <line
          x1={plan.plotLeft}
          y1={plan.topY}
          x2={plan.plotLeft}
          y2={plan.baselineY}
          class="text-border"
          stroke="currentColor"
          stroke-width="1"
          vector-effect="non-scaling-stroke"
        />

        {/* 纵轴读数：100% 与 0%，贴在左轴外侧。锚点与 `yLabelFits` 里的算式必须一致：
            右边缘在 `plotLeft - yLabelGap`，`planLine()` 已断言它装得进左边距。 */}
        {plan.axisLabels.map((axis) => (
          <text
            x={plan.plotLeft - LINE_GEOMETRY.yLabelGap}
            y={axis.y + 5}
            text-anchor="end"
            font-size={LINE_GEOMETRY.axisFont}
            class="text-muted-foreground"
            fill="currentColor"
          >
            {axis.label}
          </text>
        ))}

        {/* 折线本体：1.5px，圆头圆角只在拐点处，不带填充、不带阴影。
            `vector-effect` 让 1.5px 在任何缩放下都是 1.5px（viewBox 被缩小时不跟着变细）。 */}
        <path
          d={plan.path}
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        />

        {/* 横轴：首尾两个日期，贴着绘图区两端。
            装不下时只画尾部那个——`formatLong()` 的写法一个就 130px 上下，
            两个都画会叠成一团；完整范围在 aria-label 与下面那张表里。 */}
        {
          plan.xLabelsFit ? (
            <text
              x={plan.plotLeft}
              y={plan.height - 5}
              text-anchor="start"
              font-size={LINE_GEOMETRY.axisFont}
              class="text-muted-foreground"
              fill="currentColor"
            >
              {plan.firstLabel}
            </text>
          ) : null
        }
        {
          plan.showLastLabel ? (
            <text
              x={plan.plotLeft + plan.plotWidth}
              y={plan.height - 5}
              text-anchor="end"
              font-size={LINE_GEOMETRY.axisFont}
              class="text-muted-foreground"
              fill="currentColor"
            >
              {plan.lastLabel}
            </text>
          ) : null
        }
      </svg>
      </div>

      {/*
        读屏拿到的必须是数字：`role="img"` 的图形不朗读内部文本，所以每个点的
        读数逐条列在这张对视力读者隐藏的表里。百分比按 0..1 的比例换算，
        不保留小数——图上读不出 1% 以下的差别，表格里也不必假装读得出。

        `sr-only` 挂在 div 上而不是表上：表格布局把 `height: 1px` 当 min-height
        对待，90 个点的表会撑回两千多像素，绝对定位后把文档滚动区拉出一大段
        空白（与 `BarSquares` 同一个坑，见那边的完整说明）。
      */}
      <div class="sr-only">
        <table>
          <caption>图表数值：{plan.samples.length} 个点的完成率</caption>
          <thead>
            <tr>
              <th scope="col">日期</th>
              <th scope="col">完成率</th>
            </tr>
          </thead>
          <tbody>
            {plan.samples.map((sample) => (
              <tr>
                <th scope="row">{sample.x}</th>
                <td>{Math.round(sample.y * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}
