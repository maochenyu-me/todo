---
/**
 * 今天页（`/`）右手的辅助栏：迷你月历 + 标签 + 本周小结，三张面板卡。
 *
 * 只在构建期渲染：零 `<script>`、零 `client:*`，数据全部由页面传入的
 * `entries`（`loadAllEntries` 的产物）就地算出。面板语汇与全站一致：
 * `bg-card` + 1px 边框 + 收紧的圆角。
 *
 * 文案口径注意：E2E 对首页有「已完成 N / M」的唯一性断言（主列表的刻度那一句），
 * 所以这里的数字一概**不**用「已完成」开头——措辞各自独立，避免撞车。
 */
import { startOfWeekGrid, parseDateKey } from '../lib/date';
import { calendarDays, monthStart } from '../lib/months';
import { streak, weeklyDone } from '../lib/stats';
import { collectTags, hasTagPage, tagPath } from '../lib/tags';
import { withBase } from '../lib/urls';
import { siteConfig } from '../../site.config.ts';
import type { DayEntry } from '../lib/types';

interface Props {
  entries: DayEntry[];
  /** 「今天」的唯一依据，由页面按 `siteConfig.site.timeZone` 算好传进来。 */
  todayKey: string;
  /** 传入的 class 追加在 aside 上（工作台两栏切换的响应式类由页面持有）。 */
  class?: string;
}

const { entries, todayKey, class: className } = Astro.props;

const { weekStartsOn, tagRules } = siteConfig.frontend;

/* ---------- 迷你月历：与 CalendarMonth 同一套网格算术 ---------- */

const monthKey = todayKey.slice(0, 7);
const firstKey = monthStart(monthKey);
const grid = startOfWeekGrid(firstKey, weekStartsOn);
const monthDays = calendarDays(entries, monthKey, 0);
const byDate = new Map(monthDays.map((day) => [day.date, day]));

const WEEK_LABELS = ['日', '一', '二', '三', '四', '五', '六'] as const;
const weekLabels = Array.from({ length: 7 }, (_, i) => WEEK_LABELS[(weekStartsOn + i) % 7]);

/* ---------- 标签：与 /tags 同一份 collectTags，取前几名 ---------- */

const ASIDE_TAG_LIMIT = 8;
const tags = collectTags(entries, tagRules).slice(0, ASIDE_TAG_LIMIT);

/* ---------- 本周小结 ---------- */

/** `weeklyDone` 最后一项恒为 todayKey 所在周（周一起算），长度 1 即「只有本周」。 */
const week = weeklyDone(entries, todayKey, 1)[0];
const streakDays = streak(entries, todayKey);

/** 月历格子的链接与 CalendarMonth 同口径：今天也指 `/date/<key>`（列举视角）。 */
function dayHref(dateKey: string): string {
  return withBase(`/date/${dateKey}`);
}
---

<aside class:list={['grid gap-4 sm:grid-cols-3 sm:gap-5 xl:grid-cols-1 xl:gap-5', className]}>
  <section aria-labelledby="aside-month-heading" class="rounded-md border border-border bg-card p-4">
    <h2 id="aside-month-heading" class="text-[0.8125rem] font-medium text-muted-foreground">本月</h2>
    <div class="mt-3">
      <ul class="grid grid-cols-7 gap-x-0.5 pb-1" aria-hidden="true">
        {
          weekLabels.map((label) => (
            <li class="text-[0.625rem] text-muted-foreground">{label}</li>
          ))
        }
      </ul>
      <ul class="grid grid-cols-7 gap-x-0.5 gap-y-0.5">
        {
          grid.map((dateKey) => {
            const cell = byDate.get(dateKey);
            const dayNumber = parseDateKey(dateKey).d;
            const isToday = dateKey === todayKey;

            if (!cell) {
              return (
                <li class="px-0.5 py-0.5 text-[0.6875rem] tabular-nums text-muted-foreground/60">
                  {dayNumber}
                </li>
              );
            }

            const pct = cell.total === 0 ? 0 : Math.round((cell.done / cell.total) * 100);
            return (
              <li class="px-0.5 py-0.5">
                <a
                  href={dayHref(dateKey)}
                  aria-current={isToday ? 'date' : undefined}
                  class:list={[
                    'block rounded-[2px] transition-colors hover:bg-muted',
                    isToday ? 'text-seal' : 'text-foreground',
                  ]}
                >
                  <span class="block text-[0.6875rem] leading-4 tabular-nums">{dayNumber}</span>
                  <span class="mt-0.5 block h-[2px] w-full bg-muted" aria-hidden="true">
                    <span class="block h-full bg-foreground" style={`width:${pct}%`} />
                  </span>
                  <span class="sr-only">
                    {isToday ? '今天，' : ''}{cell.total === 0 ? '没有条目' : `完成 ${cell.done} / ${cell.total}`}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
    <a
      href={withBase('/calendar/')}
      class="mt-3 inline-block text-[0.75rem] text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
    >
      整月日历（{monthDays.length} 天有记录）
    </a>
  </section>

  <section aria-labelledby="aside-tags-heading" class="rounded-md border border-border bg-card p-4">
    <h2 id="aside-tags-heading" class="text-[0.8125rem] font-medium text-muted-foreground">标签</h2>
    {
      tags.length === 0 ? (
        <p class="mt-2.5 text-[0.8125rem] text-muted-foreground">还没有任何标签。</p>
      ) : (
        <ul class="mt-2.5 space-y-1">
          {tags.map(({ tag, count }) =>
            hasTagPage(tag) ? (
              <li>
                <a
                  href={tagPath(tag)}
                  class="flex items-baseline justify-between gap-2 text-[0.8125rem] text-foreground underline-offset-4 transition-colors hover:text-primary hover:underline"
                >
                  <span class="truncate">#{tag}</span>
                  <span class="shrink-0 text-[0.75rem] tabular-nums text-muted-foreground">{count}</span>
                </a>
              </li>
            ) : (
              <li class="flex items-baseline justify-between gap-2 text-[0.8125rem] text-muted-foreground">
                <span class="truncate">#{tag}</span>
                <span class="shrink-0 text-[0.75rem] tabular-nums">{count}</span>
              </li>
            ),
          )}
        </ul>
      )
    }
    <a
      href={withBase('/tags')}
      class="mt-3 inline-block text-[0.75rem] text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
    >
      全部标签
    </a>
  </section>

  <section aria-labelledby="aside-week-heading" class="rounded-md border border-border bg-card p-4">
    <h2 id="aside-week-heading" class="text-[0.8125rem] font-medium text-muted-foreground">本周小结</h2>
    <dl class="mt-2.5 space-y-2 text-[0.8125rem]">
      <div class="flex items-baseline justify-between gap-2">
        <dt class="text-muted-foreground">本周划掉</dt>
        <dd class="font-medium text-foreground">
          {week.done} <span class="text-muted-foreground">/ {week.total} 条</span>
        </dd>
      </div>
      <div class="flex items-baseline justify-between gap-2">
        <dt class="text-muted-foreground">连续打卡</dt>
        <dd class="font-medium text-foreground">{streakDays} 天</dd>
      </div>
    </dl>
    <a
      href={withBase('/stats')}
      class="mt-3 inline-block text-[0.75rem] text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
    >
      看全部统计
    </a>
  </section>
</aside>
