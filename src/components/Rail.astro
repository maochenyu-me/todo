---
import { Archive, BookOpen, CalendarDays, ChartLine, Tag } from '@lucide/astro';
import type { NavKey } from '../lib/types';
import { withBase } from '../lib/urls';
import { siteConfig } from '../../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  activeNav?: NavKey;
}

const { activeNav } = Astro.props;

/**
 * 导航项的顺序与图标写在这里；**是否出现只由 `siteConfig.frontend.pages` 决定**，
 * 配置里关掉的页面不出现在导航里。（`pages.day` 不是独立导航项：单日页归在今天之下。）
 */
const NAV_ITEMS = [
  { key: 'today', label: '今天', href: '/', Icon: BookOpen },
  { key: 'archive', label: '归档', href: '/archive', Icon: Archive },
  { key: 'calendar', label: '日历', href: '/calendar', Icon: CalendarDays },
  { key: 'tags', label: '标签', href: '/tags', Icon: Tag },
  { key: 'stats', label: '统计', href: '/stats', Icon: ChartLine },
] as const;

const pages = siteConfig.frontend.pages;
const items = NAV_ITEMS.filter((item) => pages[item.key]);
---

<!--
  桌面：常驻左检索栏（sticky、整屏高），底色用 card——一张更白一点的索引卡，
  贴在正文这张簿纸上。标题在上、索引导航在中、明暗切换贴底。
  窄屏：整条收成页首顶栏——品牌在左、明暗在右，导航变成一排等宽检索标签，
  当前那张标签下方压一道实线（标签页语汇，不是装饰）。
  两种形态共用同一份 DOM，只靠 lg: 前缀切换。
-->
<header class="lg:sticky lg:top-0 lg:z-40 lg:h-dvh lg:w-60 lg:shrink-0 lg:bg-card">
  <div
    class="flex flex-wrap items-center px-5 pt-3 sm:px-8 lg:h-full lg:flex-col lg:flex-nowrap lg:items-stretch lg:px-6 lg:pt-10 lg:pb-8"
  >
    <a
      href={withBase('/')}
      class="order-1 min-w-0 text-[1.0625rem] font-semibold tracking-[-0.01em] text-foreground transition-colors hover:text-primary"
      >{siteConfig.site.title}</a
    >
    <p
      class="order-2 mt-2.5 hidden w-full text-[0.8125rem] leading-relaxed text-muted-foreground lg:block"
    >
      {siteConfig.site.tagline}
    </p>

    <ThemeToggle />

    <nav aria-label="主导航" class="order-3 w-full lg:mt-8 lg:w-auto">
      <ul class="flex w-full lg:flex-col lg:gap-0.5">
        {
          items.map(({ key, label, href, Icon }) => {
            const isActive = activeNav === key;
            return (
              <li class="min-w-0 flex-1 lg:flex-none">
                <a
                  href={withBase(href)}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-center gap-1.5 border-b-2 py-2.5 text-[0.875rem] whitespace-nowrap transition-colors lg:justify-start lg:gap-2.5 lg:border-b-0 lg:py-1.5 lg:pr-2 lg:text-[0.9375rem]',
                    isActive
                      ? 'border-primary font-medium text-foreground'
                      : 'border-transparent text-muted-foreground hover:text-foreground',
                  ]}
                >
                  {/* 索引标签的那道小竖线：实心＝当前页（桌面左栏可见，窄屏用小横线取代） */}
                  <span
                    class:list={[
                      'hidden h-[1.125rem] w-[2px] shrink-0 lg:block',
                      isActive ? 'bg-primary' : 'bg-transparent',
                    ]}
                    aria-hidden="true"
                  />
                  <Icon size={15} stroke-width={1.75} class="shrink-0" aria-hidden="true" />
                  <span>{label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
